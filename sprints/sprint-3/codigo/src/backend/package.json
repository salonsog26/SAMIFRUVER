{
    "name": "samifruber-backend",
    "version": "1.0.0",
    "description": "Backend para SAMIFRUBER",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:html": "vitest run --coverage --reporter=default --reporter=html --outputFile.html=./reports/test-report/index.html",
        "db:init": "node scripts/db-init.js",
        "db:migrar-json": "node scripts/migrar-json.js",
        "db:hash": "node scripts/hash-password.js",
        "pedido:avanzar": "node scripts/avanzar-pedido.js"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^2.1.8",
        "@vitest/ui": "^2.1.8",
        "supertest": "^7.0.0",
        "vitest": "^2.1.8",
        "pg-mem": "^3.0.5"
    }
}
